# Copia este archivo como .env y cambia los valores. El .env NUNCA se sube a Git.

# Configuración General
PROJECT_NAME="ORIZEN - Kitchen & Delivery Flow API"
API_V1_STR="/api/v1"
ECHO_SQL=False

# Seguridad (JWT) - OBLIGATORIAS: sin ellas la API no arranca.
# Genera la clave con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# (el valor de ejemplo es corto a propósito: si no lo cambias, la API no arranca)
SECRET_KEY="CAMBIAME"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Primer administrador (se crea solo si no hay usuarios). Mínimo 8 caracteres.
FIRST_ADMIN_EMAIL="admin@orizen.com"
FIRST_ADMIN_PASSWORD="CAMBIAME"

# Zona horaria y CORS (CORS va como lista JSON)
TIMEZONE="America/Bogota"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ========================================================
# Selección de Base de Datos: "sqlite" o "postgres"
# ========================================================
DB_TYPE="sqlite"

# Opción A: SQLite local
SQLITE_URL="sqlite+aiosqlite:///./fastapi_demo.db"

# Opción B: Neon / PostgreSQL (pega la cadena de Neon tal cual, config.py la adapta)
POSTGRES_URL="postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Contraseña de los usuarios demo que crea: python -m app.seed
SEED_PASSWORD="orizen2026"
