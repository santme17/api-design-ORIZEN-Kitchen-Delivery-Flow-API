# Configuración General
PROJECT_NAME="FastAPI SQLModel API"
API_V1_STR="/api/v1"
ECHO_SQL=False

# ========================================================
# Selección de Base de Datos: "sqlite" o "postgres"
# ========================================================
DB_TYPE="sqlite"

# Opción A: SQLite local
SQLITE_URL="sqlite+aiosqlite:///./fastapi_demo.db"

# Opción B: Neon.com / PostgreSQL (Pega directamente la cadena de conexión de Neon)
# Ejemplo Neon: postgresql://neondb_owner:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/dbname?sslmode=require"